# ============================================================
# AGENT — copy this file to backend/.env, then adjust.
#
# Nothing here is required. The app boots with an empty .env: the whole UI works,
# and only the feature whose dependency you have not connected fails — with a
# message that says what to do about it.
# ============================================================

AGENT_PORT=3041
AGENT_DB_PATH=data/agent.json

# --- The air gap. A property of the deployment, never a UI switch. ---
# true => no cloud model, no external Ollama, internal MCP endpoints only, offline package
# managers, loopback-only kernel sandbox for local MCP servers (macOS). See SECURITY.md.
AGENT_AIRGAPPED=true
# Domain suffixes that count as internal before resolution, comma-separated.
AGENT_INTERNAL_DOMAINS=
# Testing only, on non-sensitive data: allows an Ollama `-cloud` model. Nothing else opens.
AGENT_ALLOW_CLOUD_MODEL=false

# --- The model: an Ollama server on this machine or inside your network. ---
AGENT_OLLAMA_BASE_URL=http://localhost:11434
# The reasoning model. It needs the `tools` capability, or the agent cannot call anything.
AGENT_MODEL=gpt-oss:20b
# Used for the critic, the gap check, compaction and titles — never the answer. It runs
# several times per question, so a smaller model here saves real time.
# Empty => the main model is reused.
AGENT_FAST_MODEL=
AGENT_LLM_TIMEOUT_S=900
# 0 => window taken from the model, capped at 16k for a model running here and 64k for one
# Ollama hosts. A window larger than local memory can hold pushes the model onto the CPU.
AGENT_NUM_CTX=0

# --- Access ---
# Empty => admin is reachable from this machine only.
# Set => password required everywhere, loopback included.
AGENT_ADMIN_PASSWORD=
# Lets other machines use the agent (not admin) after sign-in. With neither password set,
# the app answers this machine only.
AGENT_ACCESS_PASSWORD=
# Host names the app answers to besides localhost (DNS-rebinding guard), comma-separated.
AGENT_ALLOWED_HOSTS=
AGENT_SESSION_TTL_S=604800

# --- Guardrails: sane defaults, all overridable ---
AGENT_MAX_ITERATIONS=30          # model → tools turns within one answer
AGENT_MAX_RETRIES=2
AGENT_STAGNATION_LIMIT=2         # identical failures before the guard refuses a retry
AGENT_RUN_TIMEOUT_S=1200
AGENT_TOOL_TIMEOUT_S=180
AGENT_PARALLEL_MAX_FANOUT=4      # concurrent tool calls within one turn
AGENT_HISTORY_TURNS=20
AGENT_CRITIC_MIN_TOOLS=1         # tool calls before the final gap check runs

# --- Built-in tools ---
AGENT_WORKSPACE_DIR=data/workspace
AGENT_ENABLE_PYTHON_TOOL=true
AGENT_PYTHON_TIMEOUT_S=45
AGENT_PYTHON_MEMORY_MB=2048

# --- MCP ---
AGENT_MCP_AUTOCONNECT=true
AGENT_MCP_STARTUP_TIMEOUT_S=45
AGENT_MCP_CALL_TIMEOUT_S=180
AGENT_MCP_PROTOCOL_VERSION=2025-06-18
