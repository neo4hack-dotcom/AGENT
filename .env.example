# ============================================================
# Lumen — copiez ce fichier vers backend/.env, puis ajustez.
#
# Rien n'est obligatoire. Lumen démarre avec un .env vide : toute l'interface
# fonctionne, et seule la fonctionnalité dont la dépendance n'est pas connectée
# échoue — avec un message qui dit quoi faire.
# ============================================================

LUMEN_PORT=3041
LUMEN_DB_PATH=data/lumen.json

# --- Le modèle. Local uniquement, par conception : Ollama sur cette machine. ---
LUMEN_OLLAMA_BASE_URL=http://localhost:11434
# Vide => rien n'est deviné ; choisissez un modèle dans Administration → Modèle.
# Il lui faut la capacité « tools », sans quoi l'agent ne peut appeler aucun outil.
LUMEN_MODEL=
# Modèle plus petit pour le critique, la vérification finale et les titres.
# Vide => le modèle principal est réutilisé.
LUMEN_FAST_MODEL=
LUMEN_LLM_TIMEOUT_S=900
# 0 => fenêtre déduite du modèle, plafonnée à 16k. Une fenêtre plus large sort le
# modèle du GPU sur une machine à faible mémoire et divise la vitesse par plusieurs.
LUMEN_NUM_CTX=0

# --- Administration ---
# Vide => l'administration n'est accessible que depuis cette machine.
# Renseigné => mot de passe exigé partout, y compris en local.
LUMEN_ADMIN_PASSWORD=
LUMEN_SESSION_TTL_S=604800

# --- Garde-fous : valeurs par défaut raisonnables, toutes surchargeables ---
LUMEN_MAX_ITERATIONS=14          # tours modèle → outils pour une seule réponse
LUMEN_MAX_RETRIES=2
LUMEN_STAGNATION_LIMIT=2         # échecs identiques avant blocage par la garde
LUMEN_RUN_TIMEOUT_S=1200
LUMEN_TOOL_TIMEOUT_S=180
LUMEN_PARALLEL_MAX_FANOUT=4      # appels d'outils simultanés dans un même tour
LUMEN_HISTORY_TURNS=20
LUMEN_CRITIC_MIN_TOOLS=1         # outils appelés avant la vérification finale

# --- Outils natifs ---
LUMEN_WORKSPACE_DIR=data/workspace
LUMEN_ENABLE_PYTHON_TOOL=true
LUMEN_PYTHON_TIMEOUT_S=45
LUMEN_PYTHON_MEMORY_MB=2048
LUMEN_ENABLE_WEB_TOOLS=true
LUMEN_WEB_TIMEOUT_S=30
LUMEN_WEB_FETCH_MAX_BYTES=3000000

# --- MCP ---
LUMEN_MCP_AUTOCONNECT=true
LUMEN_MCP_STARTUP_TIMEOUT_S=45
LUMEN_MCP_CALL_TIMEOUT_S=180
LUMEN_MCP_PROTOCOL_VERSION=2025-06-18
